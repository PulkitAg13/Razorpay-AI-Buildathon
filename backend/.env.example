# RECOVERX AI — Environment Configuration
# Copy this to .env and fill in your keys

# ── App ─────────────────────────────────────────────────────────
APP_NAME=RECOVERX AI
APP_ENV=development
DEBUG=true
HOST=0.0.0.0
PORT=8000

# ── Database ────────────────────────────────────────────────────
# Local dev (SQLite — no setup required):
DATABASE_URL=sqlite+aiosqlite:///./recoverx.db

# Production (PostgreSQL — uncomment and configure):
# DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/recoverx

# ── LLM Provider ────────────────────────────────────────────────
# Options: mock | gemini | openai
# Leave as "mock" to run without any API key (full demo mode)
LLM_PROVIDER=mock

# Gemini (recommended for Razorpay Buildathon):
# LLM_PROVIDER=gemini
# GEMINI_API_KEY=your_gemini_api_key_here
# GEMINI_MODEL=gemini-1.5-flash

# OpenAI (alternative):
# LLM_PROVIDER=openai
# OPENAI_API_KEY=your_openai_api_key_here
# OPENAI_MODEL=gpt-4o-mini

# ── Event Bus ───────────────────────────────────────────────────
# Options: memory | redis
# "memory" works without Redis installed (default for local dev)
EVENT_BUS=memory
# REDIS_URL=redis://localhost:6379

# ── Recovery Policy Rules ────────────────────────────────────────
MAX_CONTACT_ATTEMPTS=5
MAX_RECOVERY_COST_RATIO=0.05
HUMAN_APPROVAL_THRESHOLD=100000
HIGH_VALUE_THRESHOLD=50000
MIN_CONFIDENCE_FOR_AUTO=0.60
CONTACT_HOURS_START=9
CONTACT_HOURS_END=21

# ── Simulation ──────────────────────────────────────────────────
SIMULATION_SEED=42
